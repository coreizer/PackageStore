<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PackageStore.Views.MessageDialog"
        Title="Package Store"
        Icon="/Assets/app.png"
        Width="420"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="20,18,20,16" Spacing="14">
    <Grid ColumnDefinitions="Auto,*">
      <!-- アイコン（情報 / 警告 / エラー） -->
      <Border x:Name="IconBadge"
              Width="36" Height="36"
              CornerRadius="18"
              VerticalAlignment="Top"
              Margin="0,0,14,0">
        <TextBlock x:Name="IconGlyph"
                   FontSize="18"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
      </Border>
      <StackPanel Grid.Column="1" Spacing="6">
        <TextBlock x:Name="HeadingText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
        <SelectableTextBlock x:Name="MessageText" TextWrapping="Wrap" Classes="muted" />
      </StackPanel>
    </Grid>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button x:Name="NoButton" Content="No" MinWidth="84" IsCancel="True" Click="OnNoClick" IsVisible="False" />
      <Button x:Name="OkButton" Content="OK" MinWidth="84" IsDefault="True" Classes="accent" Click="OnOkClick" />
    </StackPanel>
  </StackPanel>
</Window>
